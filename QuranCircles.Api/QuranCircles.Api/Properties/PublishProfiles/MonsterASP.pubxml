<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://albayan-ali.center/</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
    <ExcludeApp_Data>True</ExcludeApp_Data>
    <MSDeployServiceURL>https://site90430.siteasp.net:8172/msdeploy.axd</MSDeployServiceURL>
    <DeployIisAppPath>site90430</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>True</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>False</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>True</EnableMsDeployAppOffline>
    <UserName>site90430</UserName>
    <_SavePWD>False</_SavePWD>
    <TargetFramework>net9.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <AllowUntrustedCertificate>True</AllowUntrustedCertificate>
    <AuthType>Basic</AuthType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Preserve database files, signing keys and the existing host configuration. -->
    <MsDeploySkipRules Include="PreserveHostConfiguration">
      <ObjectName>filePath</ObjectName>
      <AbsolutePath>(^|[\\/])appsettings(?:\.Production)?\.json$</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="PreserveDatabaseFiles">
      <ObjectName>filePath</ObjectName>
      <AbsolutePath>(^|[\\/])quran\.db(?:-(?:wal|shm|journal))?$</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="PreserveApplicationData">
      <ObjectName>dirPath</ObjectName>
      <AbsolutePath>(^|[\\/])App_Data([\\/]|$)</AbsolutePath>
    </MsDeploySkipRules>
  </ItemGroup>
</Project>
